API_KEY=...changeme...

# Include every team belonging to this club. Empty means all clubs.
CLUB_ID=906295

# Optional comma-separated team IDs to exclude, even when they belong to CLUB_ID.
EXCLUDED_TEAMS_ID=

# Comma-separated leagueCategoryId values treated as cup competitions.
# National cup is category 4; append regional cup categories when known.
CUP_LEAGUE_CATEGORY_IDS=4

# If some team caption must be rewritten for cosmetic purpose. format is VolleyManager_team1_caption:new_caption_for_team1,VolleyManager_team1_caption:new_caption_for_team2
TEAM_CAPTION_REPLACEMENT=Gibloux Volley:Gibloux Volley F1,Gibloux Volley F4 A:Gibloux Volley F4,Gibloux Volley F20A:Gibloux Volley F20

# Match change notifications are published as JSON to this AWS SQS queue.
# Create the queue and the publisher credentials with the terraform setup in deployment/.
# When unset, notifications are disabled.
SQS_QUEUE_URL=

# AWS region of the queue (defaults to eu-central-1) and publisher credentials,
# as created by terraform (output publisher_access_key_id / publisher_secret_access_key).
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Where the last polled games are stored, to detect changes even across restarts.
# Defaults to /data/games-snapshot.json in the container; use a local path when running outside docker.
STATE_SNAPSHOT_PATH=./data/games-snapshot.json
